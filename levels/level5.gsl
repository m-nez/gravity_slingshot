Level 5
#include ../level_components/level_base.gsl
>Scene
	[level
		-name="level 5"
		-goal_hit_to_win=1
		-attractor_hit_to_lose=1
		-camera=[-500,-500]
		-scale=0.05
		-start_action="self.mouse_set([0.05,0.9])"
>PhysicalObject
	[escape_pod
		-name="planet"
		-image_pack="escape_pod"
		-mass=1.0
		-radius=126
		-location=[0,-1500]
		-velocity=[0, 800]
		-affected_by_gravity=True
		-path.active = True
		-path.image_pack="marker_white1"
		-path.period = 1
	[attractor1
		-attractor=True
		-mass=2000
		-image_pack="attractor1"
		-location=[1000, 4000]
		-size=[2,2]
		-radius=256
	[attractor2
		-attractor=True
		-mass=2000
		-image_pack="attractor1"
		-location=[-1000, 4000]
		-size=[2,2]
		-radius=256
	[attractor3
		-attractor=True
		-mass=1000
		-image_pack="attractor1"
		-location=[-1000, 500]
		-size=[1,1]
		-radius=126
	[attractor4
		-attractor=True
		-mass=1000
		-image_pack="attractor1"
		-location=[1000, 1500]
		-size=[1,1]
		-radius=126
	[attractor5
		-attractor=True
		-mass=2000
		-image_pack="attractor1"
		-location=[1000, -500]
		-size=[2,2]
		-radius=256
	[goal
		-location=[-500, -2000]
		-goal = True
		-image_pack="wormhole1"
		-radius=180
		-size=[1.5,1.5]
	[marslike
		-location=[2000, 2000]
		-obstacle=True
		-image_pack="marslike1"
		-mass=200000000
		-radius=510
		-size=[4,4]
