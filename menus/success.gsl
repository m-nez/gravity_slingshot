Success

>Scene
	[level
		-name="Success Screen"
		-clear_buffer = False
>TextObject
	[success_text
		-location=[0.5, 0.5]
		-size=[0.8,0.3]
		-text="Mission: Success"
		-max_chars = 16
	[next_level
		-location=[0.5, 0.7]
		-size=[0.6,0.1]
		-text="Menu [ESC] / Next level [ENTER]"
		-max_chars = 32
>Button
	[quit_screen_button
		-location=[0.25, 0.5]
                -size=[0.5, 1.0]
		-down_action="self.scene.end();self.scene.game.generate_all_texts()"
	[next_level_button
		-location=[0.75, 0.5]
                -size=[0.5, 1.0]
		-down_action="self.scene.end();self.scene.game.change_level(1);self.scene.game.play_level()"
		-shortcuts={pygame.K_RETURN, pygame.K_SPACE}
	[restart_level_button
		-location=[2.0, 2.0]
                -size=[0.0, 0.0]
		-down_action="self.scene.end();self.scene.game.play_level()"
		-shortcuts={pygame.K_r}